@model BE_PetShop.Models.Product
@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="bg-success">CHI TIẾT SẢN PHẨM</h2>
@Html.Partial("PVProductInfo", Model)
<div class="form-group" style="margin-top: 15px;">
    <div class="col-md-offset-3 col-md-9">
        @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductId }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>