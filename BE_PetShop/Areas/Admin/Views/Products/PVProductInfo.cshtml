@model BE_PetShop.Models.Product

<style>
    img {
        height: 250px;
        max-width: 250px;

    }
</style>

<div class="container-fluid">
    <div class="div-horizontal bg-info">
        <div class="col-md-3">
            <img src="@Html.DisplayFor(model => model.ImageUrl)" />
        </div>
            
            <div class="col-md-9 bg-info">
                <dl>
                    <dt>Tên sản phẩm</dt>
                    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt>Mô tả</dt>
                    <dd>@Html.DisplayFor(model => model.Description)</dd>

                    <dt>Đơn giá</dt>
                    <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

                    <dt>Danh mục</dt>
                    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
                    <dt style="padding:10px"></dt>
                </dl>
            </div>
        </div>
    </div>
