@model BE_PetShop.Models.Order

@{
    ViewBag.Title = "Chi tiết Đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div style="margin-bottom: 15px;">
    <a href="@Url.Action("Index", "Orders")" class="btn btn-default">&larr; Quay lại danh sách</a>
</div>

<h2>Chi tiết Đơn hàng #@Model.OrderID</h2>

<div class="row" style="margin-top: 20px;">
    <div class="col-md-6">
        <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4>Thông tin giao hàng</h4>
            <p><strong>Người nhận:</strong> @(Model.Customer != null ? Model.Customer.FullName : "")</p>
            <p><strong>Số điện thoại:</strong> @Model.Phone</p>
            <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
            <p><strong>Ngày đặt:</strong> @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</p>
        </div>
    </div>

    <div class="col-md-6">
        <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4>Cập nhật trạng thái</h4>
            @using (Html.BeginForm("UpdateStatus", "Orders", FormMethod.Post))
            {
                @Html.Hidden("OrderID", Model.OrderID)
                <div class="form-group">
                    <label>Trạng thái giao hàng:</label>
                    <select name="OrderStatus" class="form-control">
                        <option value="Chờ xác nhận" @(Model.OrderStatus == "Chờ xác nhận" ? "selected" : "")>Chờ xác nhận</option>
                        <option value="Đang giao hàng" @(Model.OrderStatus == "Đang giao hàng" ? "selected" : "")>Đang giao hàng</option>
                        <option value="Hoàn thành" @(Model.OrderStatus == "Hoàn thành" ? "selected" : "")>Hoàn thành</option>
                        <option value="Đã hủy" @(Model.OrderStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Trạng thái thanh toán:</label>
                    <select name="PaymentStatus" class="form-control">
                        <option value="Chưa thanh toán" @(Model.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                        <option value="Đã thanh toán" @(Model.PaymentStatus == "Đã thanh toán" ? "selected" : "")>Đã thanh toán</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success">Lưu cập nhật</button>
            }
        </div>
    </div>
</div>

<h4 style="margin-top: 30px;">Sản phẩm đã đặt</h4>
<table class="table table-bordered" style="background: #fff;">
    <thead>
        <tr style="background: #f1f5f9;">
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("#,##0") đ</td>
                <td>@item.Quantity</td>
                <td>@item.SubTotal.ToString("#,##0") đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-right">Tổng cộng:</th>
            <th style="color: #dc2626; font-size: 16px;">@Model.TotalAmount.ToString("#,##0") đ</th>
        </tr>
    </tfoot>
</table>