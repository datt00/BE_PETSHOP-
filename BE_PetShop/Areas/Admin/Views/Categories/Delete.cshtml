@model BE_PetShop.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>
@using (Html.BeginForm())
{

    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <hr />
        <div class="form-group-md">
            <div class="col-md-offset-2 col-md-10">
                <h4>Bạn thực sự muốn xóa danh mục này?</h4>
            </div>
        </div>
        <div class="form-group">
            <div class="control-label col-md-2">Tên danh mục</div>
            <div class="col-md-10">
                @* Giá trị của trường CategoryName *@
                @Html.DisplayFor(model => model.CategoryName)
            </div>


        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Xóa" class="btn btn-default btn-sm" />
            @Html.ActionLink("Quay lại danh sách", "Index", null,
                new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>
}

