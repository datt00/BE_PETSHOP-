@model IEnumerable<BE_PetShop.Models.ProductCardViewModel>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayoutPage1.cshtml";
}

<!-- ===== HERO BANNER ===== -->
<section style="background: linear-gradient(135deg, #ea580c 0%, #f97316 55%, #fbbf24 100%);
                color: #ffffff;
                border-radius: 24px;
                padding: 45px 50px;
                margin: 25px 0 40px 0;
                box-shadow: 0 15px 35px rgba(234, 88, 12, 0.22);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
                flex-wrap: wrap;">

    <!-- Cột bên trái: Nội dung chữ -->
    <div style="flex: 1; min-width: 300px;">
        <span style="display: inline-block; background: rgba(255, 255, 255, 0.2); padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 16px;">
            🐾 GAUPETSHOP / CHĂM SÓC THÚ CƯNG
        </span>
        <h1 style="font-size: 40px; font-weight: 800; line-height: 1.2; margin-bottom: 16px;">
            Yêu thương trọn vẹn.<br />Chăm sóc tận tâm.
        </h1>
        <p style="font-size: 16px; opacity: 0.95; max-width: 500px; margin-bottom: 28px; line-height: 1.6;">
            Khám phá bộ sưu tập thức ăn, phụ kiện và đồ chơi chất lượng dành cho chó mèo.
        </p>
        <a href="#featured-products"
           style="display: inline-block; background-color: #ffffff; color: #ea580c; font-weight: 700; font-size: 15px; text-decoration: none; padding: 13px 32px; border-radius: 999px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);">
            Mua sắm ngay &rarr;
        </a>
    </div>

    <!-- Cột bên phải: Hình ảnh thú cưng -->
    <div style="flex: 0 0 380px; max-width: 100%; text-align: right;">
        <img src="https://images.unsplash.com/photo-1450778869180-41d0601e046e?auto=format&fit=crop&w=700&q=80"
             alt="Chó mèo đáng yêu"
             style="width: 100%; height: 270px; object-fit: cover; border-radius: 20px; border: 4px solid rgba(255, 255, 255, 0.35); box-shadow: 0 12px 25px rgba(0, 0, 0, 0.18);" />
    </div>
</section>

<!-- Tiêu đề khu vực sản phẩm nổi bật -->
<h2 class="section-title">Sản phẩm nổi bật</h2>

<!-- ===== KHUNG CHÍNH: danh mục trái + sản phẩm phải ===== -->
<div class="store-shell" id="featured-products">
    <!-- Cột trái: Danh mục -->
    <aside class="category-panel">
        <h3>Danh mục</h3>
        <ul class="category-list">
            <li><a href="@Url.Action("Index", "Store")">Tất cả sản phẩm</a></li>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    <li>
                        <a href="@Url.Action("Index", "Store", new { categoryId = cat.CategoryID })">@cat.CategoryName</a>
                    </li>
                }
            }
        </ul>
    </aside>

    <!-- Cột phải: Lưới chứa các Product Card -->
    <section>
        <div class="product-grid">
            @foreach (var item in Model)
            {
                <article class="product-card">
                    <div class="product-image">
                        <img src="@Url.Content("~/Content/images/" + item.ImageUrl)" alt="@item.ProductName" />
                    </div>
                    <div class="product-body">
                        <div style="color:#64748b;font-size:13px;">@item.CategoryName</div>
                        <div class="product-name">@item.ProductName</div>
                        <div class="product-price">@string.Format("{0:#,##0} đ", item.ProductPrice)</div>
                        <div class="product-actions">
                            <a class="btn-soft" href="@Url.Action("Details", "Store", new { id = item.ProductID })">Chi tiết</a>
                            <a class="btn-brand" href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })">Mua</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
</div>