@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_StoreLayoutPage1.cshtml";
}

<div class="container" style="margin-top: 60px; margin-bottom: 80px;">
    <div style="max-width: 600px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 12px; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
        <div style="font-size: 50px; color: #16a34a; margin-bottom: 15px;">&#10004;</div>
        <h2 style="font-weight: bold; color: #16a34a; margin-bottom: 10px;">Đặt hàng thành công!</h2>
        <p style="color: #475569; font-size: 16px; margin-bottom: 25px;">
            Cảm ơn bạn đã mua sắm tại GauPetShop. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.
        </p>
        <a href="@Url.Action("Index", "Store")" class="btn btn-primary btn-lg">
            Tiếp tục mua sắm
        </a>
    </div>
</div>