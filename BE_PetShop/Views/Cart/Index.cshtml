@model List<BE_PetShop.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_StoreLayoutPage1.cshtml";
}

<div class="container" style="margin-top: 40px; margin-bottom: 60px;">
    <h2 style="margin-bottom: 25px; font-weight: bold;">Giỏ hàng của bạn</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div style="background: #fff; padding: 40px; border-radius: 12px; text-align: center;">
            <p style="font-size: 16px; color: #64748b;">Giỏ hàng đang trống.</p>
            <a href="@Url.Action("Index", "Store")" class="btn btn-primary" style="margin-top: 10px;">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <table class="table table-bordered" style="background: #fff;">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn giá</th>
                    <th style="width: 150px;">Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="width: 100px;">
                            <img src="@Url.Content("~/Content/images/" + item.ImageUrl)" style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px;" />
                        </td>
                        <td style="vertical-align: middle; font-weight: 600;">@item.ProductName</td>
                        <td style="vertical-align: middle;">@item.UnitPrice.ToString("#,##0") đ</td>
                        <td style="vertical-align: middle;">
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:flex; gap:5px;" }))
                            {
                                @Html.Hidden("id", item.ProductID)
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width: 70px;" />
                                <button type="submit" class="btn btn-default btn-sm">Lưu</button>
                            }
                        </td>
                        <td style="vertical-align: middle; color: #dc2626; font-weight: bold;">
                            @item.SubTotal.ToString("#,##0") đ
                        </td>
                        <td style="vertical-align: middle; text-align: center;">
                            <a href="@Url.Action("Remove", "Cart", new { id = item.ProductID })" class="btn btn-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
            <a href="@Url.Action("Index", "Store")" class="btn btn-default">&larr; Tiếp tục mua sắm</a>
            <div style="text-align: right;">
                <h4>Tổng cộng: <span style="color: #dc2626; font-weight: bold;">@(((decimal)ViewBag.TotalAmount).ToString("#,##0")) đ</span></h4>
                <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg" style="margin-top: 10px;">Tiến hành thanh toán</a>
            </div>
        </div>
    }
</div>