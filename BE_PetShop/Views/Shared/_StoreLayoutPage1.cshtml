<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - The Pet Viet Nam</title>
    @Styles.Render("~/Content/css") 
    <link href="~/Content/ThePetVietNam.css?v=3" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <div class="store-topbar">
        <div class="container">The Pet Viet Nam - Uy tín - Chất lượng</div>
    </div>
    <header class="store-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index","Store")">THE PET<span> VIET NAM</span></a>
            <nav class="store-nav">
                @Html.ActionLink("Trang chủ", "Index", "Store")
                <a href="#">Giới thiệu</a>
                <a href="@Url.Action("Index", "Store")">Sản phẩm</a>
                <a href="#">Tin tức</a>
                <a href="#">Liên hệ</a>
                <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>

                @if (Session["Customer"] != null)
                {
                    var cus = (BE_PetShop.Models.Customer)Session["Customer"];
                    <span style="font-weight: 600; color: #2563eb; margin-left: 12px;">Xin chào, @cus.FullName</span>
                    <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                }
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="store-footer">
        <div class="container">
            <h1>Vietnam's Best Petfood Local Brands</h1>

        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
