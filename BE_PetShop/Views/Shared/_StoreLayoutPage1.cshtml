<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - The Pet Viet Nam</title>
    @Styles.Render("~/Content/css") 
    <link href="~/Content/ThePetVietNam.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <div class="store-topbar">
        <div class="container">The Pet Viet Nam - Uy tín - Chất lượng</div>
    </div>
    <header class="store-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index","Store")">THE PET<span> VIET NAM</span></a>
            <nav class="store-nav">
                @Html.ActionLink("Trang chủ", "Index", "Store") @* text, action, controller *@
                <a href="#">Giới thiệu</a>
                <a href="#">Sản phẩm</a>
                <a href="#">Tin tức</a>
                <a href="#">Liên hệ</a>
                <a href="#">Giỏ hàng</a>
                <a href="#">Đăng nhập</a>
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="store-footer">
        <div class="container">
            <h1>Vietnam's Best Petfood Local Brands</h1>

        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
